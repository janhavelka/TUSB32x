# Local compiler and documentation output; never part of the delivered library.
/build/
.pio/
__pycache__/
*.py[cod]

# ESP-IDF build output that idf.py writes next to any example or project.
# sdkconfig.defaults* and any committed sdkconfig.ci stay tracked.
build*/
managed_components/
dependencies.lock
sdkconfig
sdkconfig.old
sdkconfig.esp32*
