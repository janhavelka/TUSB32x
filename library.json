{
  "name": "TUSB32x",
  "version": "0.1.0-dev.1",
  "description": "Portable C++17 TUSB32x owner lifecycle, profile application/verification, read-only reconciliation, explicit reset, original-device recovery, complete port observations and bounded interrupt service. Bounded raw diagnostics and passive health; firmware adapters remain in development.",
  "keywords": ["tusb320", "tusb320lai", "tusb322i", "usb-type-c", "i2c"],
  "authors": [
    {"name": "Thymos Solution s.r.o", "email": "info@thymos.cz", "url": "https://www.thymos.cz"},
    {"name": "Jan Havelka", "maintainer": true}
  ],
  "license": "MIT",
  "repository": {"type": "git", "url": "https://github.com/janhavelka/TUSB32x.git"},
  "headers": [
    "TUSB32x/TUSB32x.h", "TUSB32x/Config.h", "TUSB32x/Status.h",
    "TUSB32x/CommandTable.h", "TUSB32x/Version.h"
  ],
  "build": {"includeDir": "include", "srcDir": "src", "srcFilter": "+<TUSB32x.cpp> +<TUSB32xProtocol.cpp> +<TUSB32xCodecs.cpp> +<TUSB32xOperations.cpp> +<TUSB32xDiagnostics.cpp>"},
  "export": {
    "include": [
      "include/TUSB32x/*.h", "src/TUSB32x.cpp", "src/TUSB32xProtocol.cpp",
      "src/TUSB32xProtocol.h", "src/TUSB32xCodecs.cpp", "src/TUSB32xCodecs.h", "CMakeLists.txt",
      "src/TUSB32xOperations.cpp", "src/TUSB32xOwnerTime.h", "src/TUSB32xDiagnostics.cpp",
      "library.json", "idf_component.yml", "LICENSE", "README.md", "CHANGELOG.md",
      "Doxyfile", "docs/README.md", "docs/api-contracts.md", "docs/architecture.md",
      "docs/transport.md", "docs/arduino-transport.md", "docs/idf-transport.md", "docs/integration.md",
      "docs/hil-runner.md", "docs/hardware-validation.md",
      "examples/esp_idf/Tusb32xIdf.h", "examples/esp_idf/Tusb32xIdf.cpp",
      "docs/diagnostics.md", "docs/CLI.md",
      "docs/register-map.md", "docs/register-vectors.md", "docs/variant-matrix.md",
      "docs/device-behavior.md", "docs/feature-coverage.md", "docs/development.md",
      "examples/README.md", "examples/arduino/Tusb32xWire.h",
      "examples/arduino/Tusb32xWire.cpp", "examples/common/Tusb32xCli.h",
      "examples/common/Tusb32xCli.cpp", "examples/common/Tusb32xCliOutput.cpp",
      "examples/common/ConsoleBuffer.h", "examples/host/basic/CMakeLists.txt",
      "examples/host/basic/main.cpp", "examples/host/basic/profile.cpp",
      "examples/host/basic/profile.h", "examples/host/basic/README.md",
      "examples/host/basic/platformio.ini",
      "platformio.ini",
      "scripts/pio.cmd",
      "scripts/arduino_identity.py",
      "docs/arduino-examples.md",
      "examples/arduino/BoardConfig.h",
      "examples/arduino/ExampleApp.h",
      "examples/arduino/ExampleApp.cpp",
      "examples/common/ExampleOwner.h",
      "examples/common/ExampleOwner.cpp",
      "examples/common/OutputMailbox.h",
      "examples/01_basic_bringup_cli/main.cpp",
      "examples/01_basic_bringup_cli/README.md",
      "examples/02_owner_service/main.cpp",
      "examples/02_owner_service/README.md",
      "scripts/idf_identity.py",
      "examples/esp_idf/BoardConfig.h",
      "examples/esp_idf/ExampleApp.h",
      "examples/esp_idf/ExampleApp.cpp",
      "examples/esp_idf/basic/CMakeLists.txt",
      "examples/esp_idf/basic/sdkconfig.defaults",
      "examples/esp_idf/basic/sdkconfig.defaults.esp32s3",
      "examples/esp_idf/basic/main/CMakeLists.txt",
      "examples/esp_idf/basic/main/main.cpp",
      "examples/esp_idf/basic/README.md"
    ],
    "exclude": ["docs/reference/**", "docs/audit/**", "docs/prompts/**", "build/**", "**/.pio/**", "**/__pycache__/**"]
  }
}
